\u0e23\u0e15\u0e48\u0e2d?"],"Applied fonts":["\u0e41\u0e1a\u0e1a\u0e2d\u0e31\u0e01\u0e29\u0e23\u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49"],"Applied color theme":["\u0e18\u0e35\u0e21\u0e2a\u0e35\u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49"],"Applied button styles":["\u0e2a\u0e44\u0e15\u0e25\u0e4c\u0e1b\u0e38\u0e48\u0e21\u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49\u0e41\u0e25\u0e49\u0e27"],"Created initial layout and pages":["\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e40\u0e04\u0e49\u0e32\u0e42\u0e04\u0e23\u0e07\u0e41\u0e25\u0e30\u0e2b\u0e19\u0e49\u0e32\u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a"],"No layouts were created":["\u0e44\u0e21\u0e48\u0e21\u0e35\u0e40\u0e04\u0e49\u0e32\u0e42\u0e04\u0e23\u0e07\u0e16\u0e39\u0e01\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e02\u0e36\u0e49\u0e19"],"Set the site logo":["\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e23\u0e39\u0e1b\u0e42\u0e25\u0e42\u0e01\u0e49\u0e40\u0e27\u0e47\u0e1a"],"Set Site Logo":["\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e23\u0e39\u0e1b\u0e42\u0e25\u0e42\u0e01\u0e49\u0e40\u0e27\u0e47\u0e1a"],"Update WordPress theme settings and styles using theme.json format":["\u0e2d\u0e31\u0e1b\u0e40\u0e14\u0e15\u0e01\u0e32\u0e23\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e18\u0e35\u0e21\u0e40\u0e27\u0e34\u0e23\u0e4c\u0e14\u0e40\u0e1e\u0e23\u0e2a\u0e41\u0e25\u0e30\u0e2a\u0e44\u0e15\u0e25\u0e4c\u0e42\u0e14\u0e22\u0e43\u0e0a\u0e49\u0e23\u0e39\u0e1b\u0e41\u0e1a\u0e1a theme.json"],"Update Theme":["\u0e2d\u0e31\u0e1b\u0e40\u0e14\u0e15\u0e18\u0e35\u0e21"],"Create, edit, or delete WordPress data entity records using the data layer":["\u0e2a\u0e23\u0e49\u0e32\u0e07 \u0e41\u0e01\u0e49\u0e44\u0e02 \u0e2b\u0e23\u0e37\u0e2d \u0e25\u0e1a \u0e23\u0e30\u0e40\u0e1a\u0e35\u0e22\u0e19\u0e40\u0e2d\u0e19\u0e17\u0e34\u0e15\u0e35\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e40\u0e27\u0e34\u0e23\u0e4c\u0e14\u0e40\u0e1e\u0e23\u0e2a \u0e42\u0e14\u0e22\u0e43\u0e0a\u0e49\u0e40\u0e25\u0e40\u0e22\u0e2d\u0e23\u0e4c\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25"],"Manage Entity Records":["\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01\u0e40\u0e2d\u0e19\u0e17\u0e34\u0e15\u0e35"],"Display a component in the UI with specified props":["\u0e41\u0e2a\u0e14\u0e07\u0e04\u0e2d\u0e21\u0e42\u0e1e\u0e40\u0e19\u0e19\u0e15\u0e4c\u0e43\u0e19 UI \u0e14\u0e49\u0e27\u0e22 props \u0e17\u0e35\u0e48\u0e01\u0e33\u0e2b\u0e19\u0e14"],"Show Component":["\u0e41\u0e2a\u0e14\u0e07\u0e2a\u0e48\u0e27\u0e19\u0e1b\u0e23\u0e30\u0e01\u0e2d\u0e1a"],"Always use this if the user asks for something that requires a client-side assistant. Available assistants:":["\u0e43\u0e0a\u0e49\u0e2a\u0e34\u0e48\u0e07\u0e19\u0e35\u0e49\u0e40\u0e2a\u0e21\u0e2d\u0e16\u0e49\u0e32\u0e1c\u0e39\u0e49\u0e43\u0e0a\u0e49\u0e02\u0e2d\u0e2d\u0e30\u0e44\u0e23\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e1c\u0e39\u0e49\u0e0a\u0e48\u0e27\u0e22\u0e14\u0e49\u0e32\u0e19\u0e44\u0e04\u0e25\u0e40\u0e2d\u0e19\u0e15\u0e4c \u0e1c\u0e39\u0e49\u0e0a\u0e48\u0e27\u0e22\u0e17\u0e35\u0e48\u0e21\u0e35\u0e2d\u0e22\u0e39\u0e48: "],"Execute Client Assistant":["\u0e14\u0e33\u0e40\u0e19\u0e34\u0e19\u0e01\u0e32\u0e23\u0e1c\u0e39\u0e49\u0e0a\u0e48\u0e27\u0e22\u0e25\u0e39\u0e01\u0e04\u0e49\u0e32"],"Sets the processing state on a block and scrolls to it to indicate active processing":["\u0e15\u0e31\u0e49\u0e07\u0e2a\u0e16\u0e32\u0e19\u0e30\u0e01\u0e32\u0e23\u0e1b\u0e23\u0e30\u0e21\u0e27\u0e25\u0e1c\u0e25\u0e1a\u0e19\u0e1a\u0e25\u0e47\u0e2d\u0e01\u0e41\u0e25\u0e30\u0e40\u0e25\u0e37\u0e48\u0e2d\u0e19\u0e44\u0e1b\u0e22\u0e31\u0e07\u0e21\u0e31\u0e19\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e41\u0e2a\u0e14\u0e07\u0e01\u0e32\u0e23\u0e1b\u0e23\u0e30\u0e21\u0e27\u0e25\u0e1c\u0e25\u0e17\u0e35\u0e48\u0e40\u0e1b\u0e34\u0e14\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19"],"Set Processing State":["\u0e15\u0e31\u0e49\u0e07\u0e04\u0e48\u0e32\u0e01\u0e32\u0e23\u0e1b\u0e23\u0e30\u0e21\u0e27\u0e25\u0e1c\u0e25"],"Applies a collection of block edits to the canvas":["\u0e43\u0e0a\u0e49\u0e01\u0e32\u0e23\u0e41\u0e01\u0e49\u0e44\u0e02\u0e1a\u0e25\u0e47\u0e